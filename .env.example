# Copie ce fichier en « .env » puis complète-le.

# Clé API EIA gratuite : https://www.eia.gov/opendata/register.php
# Sans clé, l'ingestion API est ignorée (statut « skipped ») : le projet
# fonctionne quand même avec les fichiers publics EIA-930 (backfill / replay).
EIA_API_KEY=

POSTGRES_DB=energypulse
POSTGRES_USER=energypulse
POSTGRES_PASSWORD=energypulse

AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
# Clé de chiffrement Airflow (Fernet). Garde la même entre deux redémarrages.
AIRFLOW_FERNET_KEY=N3-OqamAIiMb1sKXm3heeNnSYc1lYdcdcMM6l9VtIqE=

# Disjoncteur : nombre d'échecs avant coupure, durée de la coupure
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_COOLDOWN_MINUTES=30
